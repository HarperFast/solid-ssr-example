{
	"name": "solid-ssr-example",
	"private": true,
	"type": "module",
	"scripts": {
		"build:client": "vite build --ssrManifest --outDir dist/client",
		"build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
		"build": "npm run build:client && npm run build:server",
		"format": "prettier --write .",
		"pretest:integration": "npm run build",
		"test:integration": "harper-integration-test-run integrationTests/**/*.test.ts"
	},
	"dependencies": {
		"harper": "^5.0.28",
		"solid-js": "^1.9.3",
		"vite": "^5.4.9",
		"vite-plugin-solid": "^2.10.2"
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "^0.0.1",
		"@harperfast/integration-testing": "^0.4.0",
		"prettier": "^3.3.3",
		"typescript": "^6.0.3"
	},
	"prettier": "@harperdb/code-guidelines/prettier",
	"license": "Apache-2.0"
}
